<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toon Sensei "Charcoal" (Paper & Seal family): flat dark theme; AlertDialogs pick up FlatAlertDialog -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorBackground">#1C1B19</item>
        <item name="android:statusBarColor">#1C1B19</item>
        <item name="android:navigationBarColor">#1C1B19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#C4694F</item>
        <item name="android:alertDialogTheme">@style/FlatAlertDialog</item>
    </style>

    <style name="FlatAlertDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:textColorPrimary">#F6F1E7</item>
        <item name="android:textColorSecondary">#D8D2C4</item>
        <item name="android:textColorHint">#A9A294</item>
        <item name="android:colorAccent">#C4694F</item>
    </style>
</resources>
