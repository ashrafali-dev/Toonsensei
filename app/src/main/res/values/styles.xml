<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ToonSensei "Paper & Seal": window chrome follows the system light/dark setting; every screen
         paints itself from ToonTheme, so these values only cover system bars and dropdown menus. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorBackground">#FFF7F4EE</item>
        <item name="android:statusBarColor">#FFF7F4EE</item>
        <item name="android:navigationBarColor">#FFF7F4EE</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#FF2C6650</item>
        <item name="android:alertDialogTheme">@style/GlassAlertDialog</item>
    </style>

    <style name="GlassAlertDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:textColorPrimary">#FF1F1D1A</item>
        <item name="android:textColorSecondary">#FF6B665E</item>
        <item name="android:textColorHint">#FF8F897D</item>
        <item name="android:colorAccent">#FF2C6650</item>
    </style>
</resources>
